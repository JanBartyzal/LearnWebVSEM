# Zkopíruj do .env a doplň hodnoty. .env se necommituje.

# PostgreSQL
POSTGRES_PASSWORD=learnweb

# KiloCode API (Kilo Gateway) — klíč z https://app.kilo.ai
KILOCODE_API_KEY=
KILOCODE_API_BASE=https://api.kilo.ai/api/gateway

# Klíč, kterým se backend autentizuje vůči LiteLLM bráně (libovolný, začíná sk-)
LITELLM_MASTER_KEY=sk-learnweb-local

# Alias modelu z litellm/config.yaml
LLM_MODEL=content-default

# Porty na hostu
WEB_PORT=8090
API_PORT=8080
DB_PORT=5432
LITELLM_PORT=4000
